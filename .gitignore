# ══════════════════════════════════════════════════════════════════════════════
#  JoinLerite — .gitignore
# ══════════════════════════════════════════════════════════════════════════════

# ── Dependências ──────────────────────────────────────────────────────────────
node_modules/
web/node_modules/

# ── Build / Output ────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
*.tsbuildinfo

# ── Variáveis de Ambiente (NUNCA commitar chaves/secrets) ─────────────────────
.env
.env.*
*.local
web/.env
web/.env.*
web/.env.local

# ── Dados de Runtime (PDFs, XMLs, manifesto — dados sensíveis de usuários) ───
server/data/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.venv/
venv/
env/
.Python
pip-log.txt
pip-delete-this-directory.txt

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── SO — Windows ──────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
*.lnk

# ── SO — macOS ────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── SO — Linux ────────────────────────────────────────────────────────────────
*~

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Misc ──────────────────────────────────────────────────────────────────────
*.bak
*.tmp
*.swp
